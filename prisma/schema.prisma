generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Appointment {
  id         String   @id @default(uuid())
  clientName String
  date       DateTime
  time       String
  createdAt  DateTime @default(now())
  @@unique([date,time])

  @@map("appointment")
}